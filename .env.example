# ==============================================================================
# VDN (Voces de la Noticia) - Variables de Entorno (Plantilla de Configuración)
# ==============================================================================

# Supabase Backend Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Audio Streaming Server (Icecast / Zeno.fm / Shoutcast)
NEXT_PUBLIC_RADIO_STREAM_URL=https://stream.zeno.fm/f3wvbbqmdg8uv

# Base Site URL (para Metadatos OpenGraph, Sitemap y RSS Feed)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
